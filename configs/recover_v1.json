{
  "benchmark_id": "PUR_RECOVER_V1",
  "polyol_basis_parts": 100.0,
  "columns": {
    "candidate_id": "source_candidate_id",
    "blend": "blend",
    "nco_oh": "nco_oh",
    "mdi_parts": "mdi_parts",
    "eta80": "simulated_eta_80c_pa_s",
    "eta120": "simulated_eta_120c_pa_s",
    "ratio": "simulated_ratio_80c_120c",
    "domain_ratio": "simulated_domain_ratio",
    "uncertainty_radius": "simulated_log10_interval_radius",
    "chemistry_in_domain": "simulated_chemistry_in_domain_flag"
  },
  "hard_constraints": {
    "eta80_preferred_pa_s": [2.2, 5.5],
    "eta120_preferred_pa_s": [0.30, 0.60],
    "ratio_preferred": [7.0, 9.5],
    "nco_oh": [1.3, 3.0],
    "mdi_fraction_of_polyol_plus_mdi": [0.35, 0.49],
    "require_chemistry_in_domain": true
  },
  "objective": {
    "space": "log10",
    "center": "geometric_midpoint_of_preferred_window",
    "weights": {"eta80": 1.0, "eta120": 1.0, "ratio": 1.0}
  },
  "robustness": {
    "enabled": false,
    "note": "Freeze a scientifically justified robust score in PUR-FRONTIER V1 before setting enabled=true. The Agent must abstain rather than inventing one.",
    "domain_reference": 1.0,
    "domain_weight": 1.0,
    "uncertainty_weight": 1.0
  },
  "anonymization": {
    "component_columns": ["PPG400", "PPG700", "PPG1000", "PPG2000"],
    "seed": 20260909
  },
  "blind": {
    "drop_columns": ["oracle_score", "oracle_rank", "oracle_is_best", "gold_candidate_id", "oracle_feasible", "oracle_interval_inside_broad"]
  },
  "required_outputs": [
    "property_winner",
    "constrained_winner",
    "robust_winner_or_explicit_abstention",
    "active_constraint",
    "backward_design",
    "local_trends"
  ],
  "evaluation": {
    "backward_threshold_tolerance_nco_oh": 0.03,
    "primary_metric": "complete_decision_recovery"
  }
}
