{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pur-essay/agent_experiment_recommendation_v1.schema.json",
  "title": "Agent experiment recommendation V1",
  "description": "Audit schema for an uncertainty-aware Agent recommendation that is executed physically by a human wet-lab operator. A record is prospective for a measurement only when it is frozen before that measurement is inspected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_status",
    "recommendation_id",
    "result_inspection_status",
    "agent_role",
    "actuator",
    "state_variables",
    "recommended_points",
    "provenance"
  ],
  "properties": {
    "record_status": {"enum": ["DRAFT", "FROZEN"]},
    "recommendation_id": {"type": "string", "minLength": 1},
    "result_inspection_status": {
      "enum": ["no_results_inspected", "some_results_inspected", "unknown"],
      "description": "Only no_results_inspected permits a prospective claim for the corresponding measurement."
    },
    "agent_role": {
      "const": "uncertainty_aware_recommender",
      "description": "The Agent recommends but does not physically execute the experiment."
    },
    "actuator": {
      "const": "human_wet_lab_operator"
    },
    "state_variables": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formulation", "process_state"],
      "properties": {
        "formulation": {
          "type": "array",
          "items": {"type": "string"}
        },
        "process_state": {
          "type": "array",
          "items": {"enum": ["reaction_history", "thermal_hold_time", "preparation_perturbation"]},
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "uncertainty_evaluation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "method": {"type": "string"},
        "summary": {"type": "string"},
        "decision_boundary": {"type": ["string", "null"]}
      }
    },
    "recommended_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["point_id", "recommendation", "measurement_condition", "rationale", "falsification_or_acceptance_criterion"],
        "properties": {
          "point_id": {"type": "string"},
          "recommendation": {"type": "string"},
          "measurement_condition": {"type": "string"},
          "rationale": {"type": "string"},
          "expected_direction_or_ordering": {"type": ["string", "null"]},
          "falsification_or_acceptance_criterion": {"type": "string", "minLength": 1},
          "adjudication": {"enum": ["pending", "supported", "partially_supported", "falsified", "out_of_domain"]},
          "adjudication_note": {"type": "string"}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_utc", "git_commit_or_run_id"],
      "properties": {
        "generated_utc": {"type": "string"},
        "git_commit_or_run_id": {"type": "string", "minLength": 1},
        "config_sha256": {"type": ["string", "null"]},
        "prompt_sha256": {"type": ["string", "null"]},
        "human_execution_reference": {"type": ["string", "null"]}
      }
    }
  }
}
